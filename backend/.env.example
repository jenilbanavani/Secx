# ── Decisio Backend Configuration ─────────────────────────
# Copy this to .env and fill in your values.

# App
DEBUG=true

# Database (SQLite for local dev — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./decisio.db

# ── GitHub Integration ────────────────────────────────────
# OAuth credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Personal Access Token (PAT) for testing without OAuth
# Unauthenticated requests work for public repos up to 60 req/hr; PAT gives 5,000 req/hr.
GITHUB_TOKEN=

# ── LLM Multi-Provider Configuration ──────────────────────
# Options: groq | openai | anthropic | grok | mock
# Default: groq (super fast LPU inference) or mock (offline zero-token testing)
LLM_PROVIDER=groq

# 1. Groq (GroqCloud - https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 2. OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 3. Claude / Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. Grok / xAI (https://console.x.ai/)
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# ── Security ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-generate-a-real-key
